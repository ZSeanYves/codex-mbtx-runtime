///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
}

///|
async fn checked(command : @shell.Cmd) -> String {
  let result = command.output(max_output_bytes=16000000)
  guard result.exit_code() == 0 else { fail(result.stderr()) }
  result.stdout().trim().to_owned()
}

///|
async fn fingerprint(paths : Array[String], context : String) -> String {
  let quoted : Array[String] = []
  for path in paths {
    if @fs.exists(path) {
      quoted.push(path.to_json().stringify())
    }
  }
  quoted.sort()
  let hashes = if quoted.is_empty() {
    ""
  } else {
    checked(
      @shell.Cmd(
        "git",
        ["hash-object", "--stdin-paths"],
        stdin=@shell.Text(quoted.join("\n") + "\n"),
      ),
    )
  }
  checked(
    @shell.Cmd(
      "git",
      ["hash-object", "--stdin"],
      stdin=@shell.Text(quoted.join("\n") + "\n" + hashes + "\n" + context),
    ),
  )
}

///|
async fn main {
  guard @fs.exists("codex-rs/Cargo.toml") else {
    fail("Run from the repository root")
  }
  let root = @fs.realpath(".")
  for name in ["CARGO_TARGET_DIR", "CARGO_BUILD_TARGET"] {
    guard @env.get_env_var(name).unwrap_or("") == "" else {
      fail(
        "The host bundle uses codex-rs/target; unset \{name} before preparing it",
      )
    }
  }
  let started = @env.now()
  let base = root + "/_build/evaluation-bundles"
  let stamps = root + "/_build/component-builds"
  for path in [base, stamps] {
    if !@fs.exists(path) {
      @fs.mkdir(path, recursive=true)
    }
  }
  let files = checked(
      @shell.Cmd("git", [
        "ls-files", "--cached", "--others", "--exclude-standard", "codex-rs", "mbtx",
        "MODULE.bazel", "MODULE.bazel.lock",
      ]),
    )
    .split("\n")
    .map(p => p.to_owned())
    .filter(p => !p.has_suffix(".gitkeep"))
    .to_array()
  let moon_root = @env.get_env_var("MOON_HOME").unwrap_or(
    @env.get_env_var("HOME").unwrap() + "/.moon",
  )
  let dependency = moon_root + "/cache/deps/v1/sources/moonbitlang/async/0.21.3"
  if !@fs.exists(dependency + "/src/fs/moon.pkg") {
    @shell.Cmd("moon", [
      "build",
      "--target",
      "wasm",
      "--target-dir",
      root + "/_build/fixture-dependencies",
      "mbtx/fixtures/capabilities.mbtx",
    ]).run()
  }
  let toolchain : Array[String] = []
  for folder in [moon_root + "/bin", moon_root + "/lib", dependency] {
    @fs.walk(folder, max_concurrency=1, (path, names) => {
      for name in names {
        let file = path + "/" + name
        if !file.contains("/_build/") &&
          !file.contains("/.git/") &&
          name != ".DS_Store" &&
          @fs.kind(file, follow_symlink=false) == @fs.Regular {
          toolchain.push(file)
        }
      }
    })
  }
  for name in ["async", "core"] {
    toolchain.push(
      moon_root + "/registry/index/user/moonbitlang/" + name + ".index",
    )
  }
  toolchain.push(moon_root + "/cache/deps/.moon-cache")
  let build_environment : Array[String] = []
  for
    name in [
      "RUSTFLAGS", "CARGO_ENCODED_RUSTFLAGS", "CARGO_BUILD_RUSTFLAGS", "RUSTC_WRAPPER",
      "RUSTC_WORKSPACE_WRAPPER", "CARGO_PROFILE_DEV_OPT_LEVEL", "CARGO_PROFILE_DEV_LTO",
      "CARGO_PROFILE_DEV_CODEGEN_UNITS", "CC", "CFLAGS", "CXX", "CXXFLAGS", "LDFLAGS",
      "MACOSX_DEPLOYMENT_TARGET", "SDKROOT",
    ] {
    build_environment.push(name + "=" + @env.get_env_var(name).unwrap_or(""))
  }
  let cargo_home = @env.get_env_var("CARGO_HOME").unwrap_or(
    @env.get_env_var("HOME").unwrap() + "/.cargo",
  )
  let build_config = fingerprint(
    [
      cargo_home + "/config",
      cargo_home + "/config.toml",
      ".cargo/config",
      ".cargo/config.toml",
    ],
    build_environment.join("\n"),
  )
  let versions = checked(@shell.Cmd("moon", ["version", "--all"])) +
    "\n" +
    checked(@shell.Cmd("moonrun", ["--version"])) +
    "\n" +
    checked(@shell.Cmd("rustc", ["--version"], cwd="codex-rs")) +
    "\n" +
    checked(@shell.Cmd("uname", ["-sm"])) +
    "\ndev-debug0-wasm-release-v2\n" +
    build_config
  let tool_key = fingerprint(toolchain, versions)
  let rust = files.filter(p => p.has_prefix("codex-rs/") && !p.has_suffix(".md"))
  let cli_key = fingerprint(
    rust.filter(p => !p.has_prefix("codex-rs/mbtx-eval/")),
    versions,
  )
  let adapter_key = fingerprint(rust, versions)
  let model_key = fingerprint(
    files.filter(p => {
      p.has_prefix("mbtx/evaluation/") ||
      p.has_prefix("mbtx/cmd/") ||
      p == "mbtx/moon.mod" ||
      p == "mbtx/moon.lock"
    }),
    tool_key,
  )
  let reference_key = fingerprint(
    files.filter(p => {
      p.has_prefix("mbtx/reference/") ||
      p == "mbtx/scripts/validate-reference.mbtx" ||
      p == "codex-rs/ext/mbtx/src/example.mbtx" ||
      p == "mbtx/fixtures/process-policy.mbtx"
    }),
    tool_key,
  )
  let key = fingerprint(
    ["mbtx/scripts/prepare-evaluation.mbtx"],
    cli_key + adapter_key + model_key + reference_key + tool_key,
  )
  let bundle = base + "/" + key
  let costs : Array[Json] = []
  if @fs.exists(bundle + "/bundle.json") {
    @shell.Cmd(bundle + "/mbtx-eval", ["verify-bundle", bundle]).run()
    println("Reused bundle without starting compilers: \{bundle}")
  } else {
    for
      name, component_key in {
        "codex": cli_key,
        "adapter": adapter_key,
        "analysis": model_key,
        "reference": reference_key,
      } {
      let stamp = stamps + "/" + name + ".txt"
      let product = match name {
        "codex" => "codex-rs/target/debug/codex"
        "adapter" => "codex-rs/target/debug/mbtx-eval"
        "analysis" =>
          "mbtx/_build/wasm/release/build/cmd/evaluation-model/evaluation-model.wasm"
        _ =>
          "_build/reference-validation/build/examples.mbtx/wasm/release/build/single/single.wasm"
      }
      let products = if name == "adapter" {
        [product, "codex-rs/target/debug/mbtx-fixture-worker"]
      } else if name == "reference" {
        [product,
         "_build/reference-validation/build/process-examples.mbtx/wasm/release/build/single/single.wasm",
         "_build/reference-validation/build/example.mbtx/wasm/release/build/single/single.wasm"]
      } else {
        [product]
      }
      let reused = if @fs.exists(stamp) {
        let receipt = component_key +
          "\n" +
          fingerprint(products, "built products")
        @fs.read_file(stamp).text().trim() == receipt[:] &&
        @fs.exists(product) &&
        (
          name != "adapter" ||
          @fs.exists("codex-rs/target/debug/mbtx-fixture-worker")
        )
      } else {
        false
      }
      let component_start = @env.now()
      if !reused {
        match name {
          "codex" | "adapter" => {
            let args = ["build", "--locked", "-j", "4"]
            if name == "codex" {
              args.append(["-p", "codex-cli", "--bin", "codex"])
            } else {
              args.append([
                "-p", "codex-mbtx-eval", "--bin", "mbtx-eval", "--bin", "mbtx-fixture-worker",
              ])
            }
            @shell.Cmd("cargo", args, cwd="codex-rs", env={
              "CARGO_PROFILE_DEV_DEBUG": "0",
              "CARGO_INCREMENTAL": "0",
            }).run()
          }
          "analysis" =>
            @shell.Cmd(
              "moon",
              ["build", "--target", "wasm", "--release", "cmd/evaluation-model"],
              cwd="mbtx",
            ).run()
          _ =>
            @shell.Cmd("moon", ["run", "mbtx/scripts/validate-reference.mbtx"]).run()
        }
        @fs.write_file(
          stamp,
          component_key + "\n" + fingerprint(products, "built products") + "\n",
        )
      }
      costs.push({
        "component": name.to_json(),
        "fingerprint": component_key.to_json(),
        "reused": reused.to_json(),
        "elapsed_ms": (@env.now() - component_start).to_json(),
      })
    }
    @shell.Cmd("codex-rs/target/debug/mbtx-eval", [
      "bundle", "--repo", root, "--output", bundle, "--fingerprint", key,
    ]).run()
  }
  @fs.write_file(root + "/_build/evaluation-bundle.txt", bundle + "\n")
  let cost : Json = {
    "bundle": bundle.to_json(),
    "preparation_ms": (@env.now() - started).to_json(),
    "components": costs.to_json(),
    "scope": "fixed component preparation; excluded from attempts",
  }
  @fs.write_file(
    base + "/preparation-\{@env.now()}.json",
    cost.stringify(indent=2) + "\n",
  )
  println("Bundle: \{bundle}")
}
