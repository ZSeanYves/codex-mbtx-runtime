import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/shell",
}

///| Run from the repository root. This entry never calls a model or relay.
async fn main {
  @shell.Cmd("moon", [
    "build", "--frozen", "--target", "wasm",
    "--target-dir", "_build/mbtx-capabilities",
    "mbtx/fixtures/capabilities.mbtx",
  ]).run()
  let build_env : Map[String, String] = {
    "CARGO_PROFILE_DEV_DEBUG": "0",
    "CARGO_PROFILE_TEST_DEBUG": "0",
    "CARGO_INCREMENTAL": "0",
    "CARGO_BUILD_JOBS": "4",
  }
  @shell.Cmd("cargo", [
    "build", "--locked", "-p", "codex-cli", "--bin", "codex", "-j", "4",
  ], cwd="codex-rs", env=build_env).run()
  @shell.Cmd("just", [
    "test", "-p", "codex-config", "-p", "codex-tools",
    "-p", "codex-mbtx-extension", "--lib",
    "--test-threads=4", "--retries=0",
  ], cwd="codex-rs", env=build_env).run()
  @shell.Cmd("just", [
    "test", "-p", "codex-core", "--lib", "-E",
    "test(exec::) | test(exec_env::) | test(exec_policy::) | test(config::) | test(tools::parallel::) | test(tasks::) | test(tools::handlers::extension_tools::)",
    "--test-threads=4", "--retries=0",
  ], cwd="codex-rs", env=build_env).run()
  @shell.Cmd("just", [
    "test", "-p", "codex-core", "--test", "all",
    "-E", "test(suite::mbtx::)", "--run-ignored", "all", "--test-threads=1", "--retries=0",
  ], cwd="codex-rs", env=build_env).run()
  println("Stage-one validation completed. No research benefit is inferred.")
}
