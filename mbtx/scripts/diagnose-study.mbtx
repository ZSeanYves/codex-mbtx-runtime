import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

fn field(value : Json, name : String) -> Json {
  match value {
    Object(fields) => fields.get(name).unwrap_or(Json::null())
    _ => Json::null()
  }
}

fn excerpt(text : String) -> String {
  if text.length() <= 12000 { text } else {
    String::from_iter(text.iter().take(12000)) + "\n[excerpt truncated; original file retained]"
  }
}

async fn main {
  let args=@env.args()
  guard args.length()==2 else {fail("Usage: moon run mbtx/scripts/diagnose-study.mbtx RUN")}
  let root=@fs.realpath(args[1])
  let manifest=@json.parse(@fs.read_file(root+"/run.json").text())
  let lines=["Study diagnostics (read-only evidence inspection; no API calls)","Run: "+root]
  lines.push({"mode":field(manifest,"mode"),"platform":field(manifest,"platform"),"protocol":field(field(manifest,"protocol"),"protocol_id"),"bundle_revision":field(field(manifest,"bundle"),"source_revision"),"utilities":field(manifest,"utilities")}.to_json().stringify(indent=2))
  let mut report : Json=Json::null()
  let mut count = -1
  @fs.walk(root+"/reports",max_concurrency=1,(path,files)=> {
    if files.contains("report.json") {
      let candidate=@json.parse(@fs.read_file(path+"/report.json").text())
      if candidate is {"attempts":Array(attempts),..} && attempts.length()>count {
        report=candidate
        count=attempts.length()
      }
    }
  })
  guard report is {"attempts":Array(attempts),..} else {fail("No saved report; retain the run and package its raw evidence")}
  lines.push({"analysis_version":field(report,"analysis_version"),"partial":field(report,"partial"),"itt":field(report,"itt"),"conditional":field(report,"conditional")}.to_json().stringify(indent=2))
  // The first unsuccessful attempt per arm preserves both sides of the failure.
  for arm in ["shell_tool","mbtx_program"] {
    let candidates=attempts.filter(a=>field(a,"arm")==arm.to_json())
    let failed=candidates.filter(a=>field(a,"status")!=Json::string("success"))
    let selected=if failed.is_empty() {candidates.get(0)} else {failed.get(0)}
    if selected is Some(attempt) {
      guard field(attempt,"attempt_id") is String(id) && id.length()>0 && id.iter().all(c=>c.is_ascii_digit() || (c>='a' && c<='f') || c=='-') else {fail("Invalid evidence attempt id")}
      let directory=root+"/attempts/"+id
      lines.push("\nArm: "+arm+"; evidence: "+directory)
      for key in ["status","task_id","workspace","oracle","tool_outcomes","outcome","evidence"] {
        lines.push(key+": "+excerpt(field(attempt,key).stringify(indent=2)))
      }
      if @fs.exists(directory+"/codex.jsonl") {
        let events=@fs.read_file(directory+"/codex.jsonl").text()
        for line in events.split("\n") {
          if line.trim().is_empty() {continue}
          let event=@json.parse(line.to_owned()) catch {_=>Json::null()}
          if event is {"type":String("item.completed"),"item":item,..} && field(item,"type")!=Json::string("agent_message") {
            lines.push("Native tool event: "+excerpt(item.stringify(indent=2)))
          }
        }
      }
      @fs.walk(directory,max_concurrency=1,(path,files)=> {
        for name in ["codex.stderr","execution-error.json","submission.json","stderr"] {
          if files.contains(name) && (path==directory || path.has_prefix(directory+"/submission/")) {
            lines.push("\nFile: "+path+"/"+name+"\n"+excerpt(@fs.read_file(path+"/"+name).text()))
          }
        }
      })
    }
  }
  let output=root+"-diagnostics-\{@env.now()}.txt"
  guard !@fs.exists(output) else {fail("Diagnostic output already exists")}
  let text=lines.join("\n")+"\n"
  @fs.write_file(output,text)
  println(text)
  println("Diagnostic file: "+output)
}
