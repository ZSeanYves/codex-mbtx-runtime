import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

async fn main {
  let bundle=match @env.get_env_var("MBTX_BUNDLE") {Some(path)=>path;None=>@fs.read_file("_build/evaluation-bundle.txt").text().trim().to_owned()}
  let root="_build/observation-calibration/run-\{@env.now()}"
  let rows : Array[Json]=[]
  for index,condition in ["minimal","full","full","minimal"] {
    let destination=root+"/condition-\{index}"
    @shell.Cmd(bundle+"/mbtx-eval",["run","--bundle",bundle,"--output",destination,"--suite","basic","--mode","replay","--tasks","repository-impact-basic-v4","--repeats","2","--min-interval-ms","0","--observation",condition]).run()
    @fs.walk(destination+"/reports",max_concurrency=1,(path,files)=>{
      if files.contains("report.json") {
        let report=@json.parse(@fs.read_file(path+"/report.json").text())
        guard report is {"attempts":Array(attempts),"conditional":{"pairs":Number(2,..),..},..} else {fail("Calibration trajectory changed")}
        for attempt in attempts {
          guard attempt is {"status":String("success"),"accounting":{"metrics":{"agent_steps":Number(2,..),"tool_calls":Number(1,..),..},..},"outcome":{"elapsed_ns":Number(elapsed,..),..},"arm":String(arm),..} else {fail("Calibration behavior differed")}
          rows.push({"condition":condition.to_json(),"order":index.to_json(),"arm":arm.to_json(),"elapsed_ns":elapsed.to_json(),"evidence":path.to_json()})
        }
      }
    })
  }
  let result : Json = {"schema_version":1,"scope":"Incremental native OTLP observation over minimum audit capture; native step trace, full outputs, worker receipts and local Responses gate remain present in both conditions","behavior_equivalent":true,"samples":rows.to_json(),"limitations":["Small local calibration; not a backend performance result","Both conditions include unavoidable base observation overhead","Do not subtract an average calibration cost from online results","No cross-clock subtraction or sum of overlapping spans"]}
  @fs.write_file(root+"/calibration.json",result.stringify(indent=2)+"\n")
  println("Observation calibration evidence: "+root)
}
