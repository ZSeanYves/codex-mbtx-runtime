import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
}

async fn main {
  let root = @fs.realpath(".")
  let work = root + "/_build/reference-validation"
  if !@fs.exists(work) { @fs.mkdir(work, recursive=true) }
  @shell.Cmd("moon", ["build", "--frozen", "--target", "wasm", "--release", "--target-dir", work + "/build", root + "/mbtx/reference/examples.mbtx"]).run()
  let result = @shell.Cmd("moonrun", [work + "/build/wasm/release/build/single/single.wasm"], cwd=work).output()
  guard result.exit_code() == 0 else { fail(result.stderr()) }
  assert_eq(result.stdout(), "reference APIs verified\n")
  println("Frozen language and IO reference examples passed")
}
