import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

async fn main {
  let bundle=@fs.read_file("_build/evaluation-bundle.txt").text().trim().to_owned()
  let request : Json = {"schema_version":1,"op":"protocol","suite":"programs"}
  let output=@shell.Cmd(bundle+"/moonrun",[bundle+"/evaluation-model.wasm","--","--worker"],stdin=@shell.Text(request.stringify()+"\n")).output(max_output_bytes=64000000)
  assert_eq(output.exit_code(),0)
  guard @json.parse(output.stdout()) is {"ok":True,"result":{"tasks":Array(tasks),..},..} else {fail("study protocol")}
  let root="_build/study-fixture-validation/run-\{@env.now()}"
  @fs.mkdir(root,recursive=true)
  let mut checked=0
  for task in tasks {
    guard task is {"id":String(id),"withheld":Array(hidden),"reference_shell":String(source),..} else {fail("task metadata")}
    let cases=[task]
    cases.append(hidden[:])
    for index, input in cases {
      guard input is {"files":Object(files),"expected":expected,..} else {fail("input case")}
      let cwd=root+"/"+id+"-\{index}"
      @fs.mkdir(cwd,recursive=true)
      for path, content in files {
        guard content is String(content) else {fail("text fixture")}
        let parts=path.split("/").map(x=>x.to_owned()).to_array()
        if parts.length()>1 {
          let directory=cwd+"/"+parts[:parts.length()-1].join("/")
          if !@fs.exists(directory) {@fs.mkdir(directory,recursive=true)}
        }
        @fs.write_file(cwd+"/"+path,content)
      }
      @shell.Cmd("cp",[bundle+"/fixture-worker",cwd+"/fixture-worker"]).run()
      @fs.write_file(cwd+"/reference.sh",source)
      let run=@shell.Cmd("sh",["reference.sh"],cwd=cwd).output(max_output_bytes=1000000)
      guard run.exit_code()==0 else {fail("\{id} case \{index}: \{run.stderr()}")}
      let actual=@json.parse(@fs.read_file(cwd+"/result.json").text())
      guard actual==expected else {fail("\{id} case \{index}: expected \{expected.stringify()}, got \{actual.stringify()}")}
      for path, content in files {assert_eq(@fs.read_file(cwd+"/"+path).text().to_json(),content)}
      checked+=1
    }
    if checked%12==0 {println("Fixture/reference checks: \{checked}/288")}
  }
  assert_eq(checked,288)
  println("All visible and withheld fixture/reference checks passed. These prescribed programs are validation evidence only.")
}
