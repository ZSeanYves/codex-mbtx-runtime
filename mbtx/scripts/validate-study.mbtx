import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

async fn failed_replay(root : String, reason : String) -> Unit {
  let diagnostic=@shell.Cmd("moon",["run","mbtx/scripts/diagnose-study.mbtx",root]).output(max_output_bytes=200000)
  println(diagnostic.stdout())
  if diagnostic.exit_code()!=0 {println(diagnostic.stderr())}
  fail(reason+"; raw evidence retained at "+root)
}

async fn main {
  let bundle=@fs.read_file("_build/evaluation-bundle.txt").text().trim().to_owned()
  let evaluator=bundle+"/mbtx-eval"
  let root="_build/study-validation/run-\{@env.now()}"
  // Exercise the public entry point and detect common setup failures after one
  // pair, before continuing the remaining scenario coverage.
  let command=["run","mbtx/scripts/collect-study.mbtx","replay","--suite","programs","--output",root,"--variants","1","--repeats","1","--min-interval-ms","0","--batch-pairs","1"]
  @shell.Cmd("moon",command,env={"MBTX_BUNDLE":bundle}).run()
  let seals : Map[String,String] = Map([])
  @fs.walk(root+"/attempts",max_concurrency=1,(path,files)=> {
    if files.contains("seal.json") {seals[path+"/seal.json"]=@fs.read_file(path+"/seal.json").text()}
  })
  assert_eq(seals.length(),2)
  // Validate the actual model-visible request, not just the protocol template.
  // Fixed replay cannot prove that a live model follows these instructions.
  @fs.walk(root+"/attempts",max_concurrency=1,(path,files)=> {
    if files.contains("assignment.json") {
      guard @json.parse(@fs.read_file(path+"/assignment.json").text()) is {"arm":String(arm),..} else {fail("missing assignment")}
      let expected=if arm=="mbtx_program" {"solution.mbtx"} else {"solution.sh"}
      let other=if arm=="mbtx_program" {"solution.sh"} else {"solution.mbtx"}
      guard @json.parse(@fs.read_file(path+"/http/request-0000/request.json").text()) is {"input":Array(input),..} else {fail("missing actual request")}
      let instructions : Array[String] = []
      for item in input {
        if item is {"role":String(role),"content":Array(parts),..} && (role=="user" || role=="developer") {
          for part in parts {if part is {"text":String(text),..} {instructions.push(text)}}
        }
      }
      let visible=instructions.join("\n")
      assert_true(visible.contains(expected) && visible.contains("This exact file is the required submission."))
      assert_false(visible.contains(other))
    }
  })
  @fs.walk(root+"/reports",max_concurrency=1,(path,files)=> {
    if files.contains("report.json") {
      let report=@json.parse(@fs.read_file(path+"/report.json").text())
      guard report is {"partial":True,"itt":{"shell_tool":{"assigned":Number(24,..),"captured":Number(1,..),..},"mbtx_program":{"assigned":Number(24,..),"captured":Number(1,..),..},..},..} else {failed_replay(root,"First batch schedule or capture count is incorrect")}
      guard report is {"conditional":{"pairs":Number(1,..),..},..} else {failed_replay(root,"First fixed replay pair failed execution, validation or strict evidence checks; this is not a schedule failure")}
    }
  })
  let resume_command=command[:command.length()-2].to_owned()
  resume_command.append(["--batch-pairs","23","--resume"])
  @shell.Cmd("moon",resume_command,env={"MBTX_BUNDLE":bundle}).run()
  for path, content in seals {assert_eq(@fs.read_file(path).text(),content)}
  let mut complete=false
  @fs.walk(root+"/reports",max_concurrency=1,(path,files)=> {
    if files.contains("report.json") {
      let report=@json.parse(@fs.read_file(path+"/report.json").text())
      if report is {"partial":False,"conditional":{"pairs":Number(24,..),..},"attempts":Array(attempts),..} {
        complete=true
        assert_eq(attempts.length(),48)
        for attempt in attempts {
          guard attempt is {"status":String("success"),"accounting":{"metrics":{"agent_steps":Number(2,..),..},..},"submission":{"cases":Array(cases),..},..} else {fail("actual Codex study replay failed: \{attempt.stringify()}")}
          assert_eq(cases.length(),3)
        }
      }
    }
  })
  guard complete else {failed_replay(root,"Study replay did not produce 24 successful strict pairs")}
  // Exercise the secondary acceptance condition separately; no pooling.
  @shell.Cmd(evaluator,["run","--bundle",bundle,"--output",root+"-workflow","--suite","workflow","--mode","replay","--scenarios","large-log","--variants","2","--repeats","1","--min-interval-ms","0"]).run()
  @fs.walk(root+"-workflow/reports",max_concurrency=1,(path,files)=> {
    if files.contains("report.json") {
      guard @json.parse(@fs.read_file(path+"/report.json").text()) is {"suite":String("workflow"),"conditional":{"pairs":Number(1,..),..},..} else {fail("workflow cohort failed")}
    }
  })
  println("Study validation passed: 24 real-Codex pairs, 144 fresh-input executions, two immutable batches, workspace boundary checks and an independent workflow pair. No live requests or research-benefit inference.")
  println("Evidence: \{root}")
}
