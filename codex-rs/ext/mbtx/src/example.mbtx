///|
import {
  "moonbitlang/async@0.21.3",
  "moonbitlang/async@0.21.3/fs",
  "moonbitlang/async@0.21.3/shell",
  "moonbitlang/core/json",
}

///|
async fn main {
  let input = @json.parse(@fs.read_file("input.json").text())
  let child = @shell.Cmd(
    "jq", ["-c", "--arg", "label", "λ雪", ". + {label: $label}"],
    stdin=@shell.Text(input.stringify()),
  ).output()
  guard child.exit_code() == 0 else { fail(child.stderr()) }
  let output = @json.parse(child.stdout())
  @fs.write_file("copy.json", output.stringify() + "\n")
  println(output.stringify())
}
